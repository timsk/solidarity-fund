# ── Application ────────────────────────────────────────
FUND_NAME="Community Solidarity Fund"
PORT=443
HTTP_PORT=80
# AUTO_APPROVE_ELIGIBLE=true

# ── Secrets (auto-generated on first install) ────────
ADMIN_PASSWORD=
ALTCHA_HMAC_KEY=

# ── SMS (ClickSend) ───────────────────────────────────
# SMS_ENABLED=true
# SMS_LOG_LEVEL=warn
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=

# ── Email (Gmail SMTP) ────────────────────────────────
# EMAIL_ENABLED=true
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# EMAIL_FROM_NAME="Solidarity Fund"

# ── Application Status URL ────────────────────────────
# BASE_URL=https://your-domain.com

# ── Cooldown ──────────────────────────────────────────
# COOLDOWN_DAYS=90
